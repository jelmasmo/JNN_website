{
  "name": "jnn-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply jnn-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jnn-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist/client"
  },
  "dependencies": {
    "@tanstack/react-start": "^1.121.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "effect": "^3.11.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tanstack/react-router": "^1.121.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0",
    "wrangler": "^3.99.0"
  }
}
